# 1. Ứng dụng API local
# Cấu hình tiến trình API khi chạy trực tiếp trên máy phát triển.
PORT=3001
NODE_ENV=development
API_NODE_ENV=production
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001/api
FILE_STORAGE_ROOT=./storage
FILE_STORAGE_ROOT_DOCKER=/app/storage

# 2. Docker Compose local
# Định danh project, image, container, network và volume của stack.
COMPOSE_PROJECT_NAME=office-template-platform
COMPOSE_NETWORK_NAME=office-template-platform-network
CONTAINER_BIND_ADDRESS=127.0.0.1
API_IMAGE=office-template-api:local
POSTGRES_IMAGE=postgres:17-alpine
API_CONTAINER_NAME=api
POSTGRES_CONTAINER_NAME=postgres
MIGRATE_CONTAINER_NAME=migrate
DB_VOLUME_NAME=office-template-api-postgres-data
FILE_STORAGE_VOLUME_NAME=office-template-api-files
API_HOST_PORT=3001
DB_HOST_PORT=5432

# 3. PostgreSQL local
# DB_HOST dùng khi API chạy trên máy; DB_HOST_DOCKER là DNS service trong Compose.
# TypeORM đọc DB_*; DATABASE_URL cũng trỏ tới PostgreSQL local cho công cụ cần URL.
DB_HOST=localhost
DB_HOST_DOCKER=postgres
DB_PORT=5432
DB_USER=office_template
DB_PASSWORD=office_template_local_dev
DB_NAME=office_template
DB_SSL=false
DB_LOGGING=false
DATABASE_URL=postgresql://office_template:office_template_local_dev@localhost:5432/office_template

# 4. Redis local tùy chọn
# Địa chỉ local dự phòng; Redis chưa được bật trong Docker Compose hoặc kết nối bởi API.
REDIS_URL=redis://localhost:6379
